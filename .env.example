# =============================================================================
# Datathon Fase 5 — variáveis de ambiente (template). Copie para .env e ajuste.
# =============================================================================

# ---------- Etapa 1 — MLflow tracking ----------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# ---------- Etapa 2 — LLM quantizado servido em src/serving/app.py ----------
# Caminho absoluto para o GGUF Q4_K_M / Q5_K_M (llama-cpp-python).
LLM_MODEL_PATH=/models/qwen2.5-3b-instruct-q4_k_m.gguf

# Endpoint OpenAI-compatible (vLLM, llama-cpp-server, ou similar).
# O agente ReAct e o LLM-as-judge usam esses dois para falar com o LLM local.
OPENAI_API_BASE=http://localhost:8001/v1
OPENAI_API_KEY=sk-local-quantized

# ---------- Etapa 3 — observabilidade ----------------------------------------
GRAFANA_PASSWORD=admin
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR/WEBHOOK

# ---------- GAP 07 — retraining (audit trail) -------------------------------
# Sobrescrito pelos workflows GitHub Actions; em execução local mantém 'manual'.
RETRAINING_REASON=manual

# ---------- App ---------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
